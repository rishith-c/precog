# ── Persistence (required in production) ─────────────────────────────────────
# Without one of these on Vercel, accounts are switched off and /signup says so.
#   vercel blob store add precog      # creates the store and links the token
BLOB_READ_WRITE_TOKEN=

# Local development uses the filesystem under .data/ (gitignored). Override:
# PRECOG_DATA_DIR=.data

# ── Sessions (required in production) ────────────────────────────────────────
# One signing key for every function instance. If unset, each cold instance reads
# it from the store and a read-before-write race mints a second key, which signs
# users out mid-session. Generate: openssl rand -hex 32
PRECOG_SECRET=

# ── Transactional email (optional) ────────────────────────────────────────────
# Welcome mail goes through Resend when set; otherwise it is a console line.
RESEND_API_KEY=
EMAIL_FROM="Precog <onboarding@resend.dev>"

# ── Payments (not wired yet) ──────────────────────────────────────────────────
# The pricing page states no processor is connected. When these exist, the
# billing page should swap its plan toggle for Stripe Checkout + a webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
